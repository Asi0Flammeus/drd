# DRD — copy to .env and adjust. Every value below is a default, not a secret.
# The file .env is gitignored; never commit one.

# ---------------------------------------------------------------- serving ---
DRD_HOST=127.0.0.1
DRD_PORT=5178
# Absolute origin the app is reached at. Sets Secure cookies and the origin
# check on mutating requests. Leave empty for local http development.
DRD_PUBLIC_ORIGIN=
# Where the SQLite file and the captured media live. Back this up; it is the app.
DRD_DATA_DIR=./data
# Built client. Produced by `npm run build`.
DRD_CLIENT_DIR=./dist/client

# ----------------------------------------------------- docker compose only ---
# Read by docker-compose.yml, not by the server. See docs/DEPLOY.md.
# The container publishes on 127.0.0.1:4354 and must run as the uid/gid that
# owns the bind-mounted ./data, or SQLite opens read-only.
DRD_UID=
DRD_GID=
DRD_MEM_LIMIT=2g
# In the deployed stack this is https://dnd.alysis.cat; override to
# http://127.0.0.1:4354 only for a local smoke test, or the Secure session
# cookie is never sent back over plain http.

# --------------------------------------------------------------- accounts ---
DRD_REGISTRATION_OPEN=true
# Optional extra gate on registration. Not a password — a doorbell.
DRD_INVITE_CODE=
DRD_SESSION_TTL_DAYS=30

# ---------------------------------------------------------------- capture ---
DRD_CAPTURE_TIMEOUT_MS=60000
DRD_CAPTURE_NAV_TIMEOUT_MS=25000
DRD_CAPTURE_MAX_BYTES=30000000
DRD_CAPTURE_MAX_REQUESTS=400
DRD_CAPTURE_MAX_REDIRECTS=5
DRD_CAPTURE_MAX_HEIGHT=12000
DRD_CAPTURE_MAX_ELEMENTS=140
DRD_CAPTURE_MAX_CROPS=28
DRD_CAPTURE_VIEWPORT_WIDTH=1280
DRD_CAPTURE_VIEWPORT_HEIGHT=900
DRD_CAPTURE_CONCURRENCY=1
DRD_CAPTURE_PER_USER_PER_HOUR=60
# Ports a captured URL may use. Widening this widens the SSRF surface.
DRD_CAPTURE_ALLOWED_PORTS=80,443
DRD_CAPTURE_USER_AGENT=

# Chrome. Empty path uses the one Puppeteer installed.
DRD_CHROME_PATH=
# Only where a kernel sandbox is unavailable (some containers). Prefer false.
DRD_CHROME_NO_SANDBOX=false

# DANGEROUS. Disables every private-network protection so the pipeline can
# capture a fixture on 127.0.0.1 while it is being developed. Never in a
# deployment: it turns the capture endpoint into an internal-network scanner.
DRD_ALLOW_PRIVATE_NETWORK=false

# ------------------------------------------------------- optional assistant ---
# Leave empty and everything still works: export packs are built from stored
# rows, never from a model. Set all three to enable the conversation endpoint.
# The endpoint must be OpenAI-compatible; DRD posts to <endpoint>/chat/completions.
DRD_LLM_ENDPOINT=
DRD_LLM_MODEL=
DRD_LLM_API_KEY=
